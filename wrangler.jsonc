// wrangler.jsonc — Cloudflare Worker configuration for Production (nr.nasfm.info) and Staging.
{
  "name": "nas-newsroom",
  "compatibility_date": "2026-10-11",
  "main": "./src/worker.ts",
  "routes": [
    {
      "pattern": "nr.nasfm.info",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nas-newsroom-db",
      "database_id": "afb6589e-0630-44db-9dae-0a6d2015b28f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nr.nasfm.info"
  },
  "env": {
    "staging": {
      "name": "nas-newsroom-staging",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nas-newsroom-staging-db",
          "database_id": "16f339cc-4038-44a5-a522-a933dc2ba07b",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://nas-newsroom-staging.nasfm98-7.workers.dev"
      }
    }
  }
}
